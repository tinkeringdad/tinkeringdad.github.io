<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="96dp" android:paddingEnd="96dp" android:paddingTop="40dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/mic" style="@style/Pill"
            android:layout_width="wrap_content" android:layout_height="56dp"
            android:text="🎤  Speak" android:textColor="@color/pill_text"
            android:layout_marginEnd="16dp" />
        <EditText android:id="@+id/query"
            android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1"
            android:background="@drawable/field"
            android:paddingStart="28dp" android:paddingEnd="28dp"
            android:hint="@string/search_hint"
            android:textColorHint="@color/muted" android:textColor="@color/text"
            android:textSize="22sp" android:singleLine="true"
            android:inputType="text" android:imeOptions="actionSearch|flagNoExtractUi" />
    </LinearLayout>

    <TextView android:id="@+id/status"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="20dp" android:layout_marginBottom="8dp"
        android:textSize="17sp" android:textColor="@color/muted"
        android:text="Type or speak. Results are your apps and the apps that can search, nothing else." />

    <ListView android:id="@+id/results"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:divider="@null" android:dividerHeight="10dp"
        android:listSelector="@drawable/tile_selector"
        android:drawSelectorOnTop="true"
        android:scrollbars="none" android:paddingBottom="32dp" android:clipToPadding="false" />
</LinearLayout>
