<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:id="@+id/box"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="120dp" android:paddingEnd="120dp"
        android:paddingTop="40dp" android:paddingBottom="60dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Plain TV" android:textSize="34sp" android:textColor="@color/text" />

        <TextView android:id="@+id/status"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:textSize="18sp" android:textColor="@color/muted" />

        <TextView android:id="@+id/openA11y" style="@style/Pill"
            android:layout_width="wrap_content" android:layout_height="48dp"
            android:layout_marginTop="16dp" android:textColor="@color/pill_text"
            android:text="Open accessibility settings" />

        <Switch android:id="@+id/swHome"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="28dp" android:minHeight="56dp"
            android:background="@drawable/row_selector" android:paddingStart="20dp" android:paddingEnd="20dp"
            android:textSize="19sp" android:textColor="@color/text"
            android:text="Home button opens Plain TV, not Google TV" />

        <Switch android:id="@+id/swAssist"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:minHeight="56dp"
            android:background="@drawable/row_selector" android:paddingStart="20dp" android:paddingEnd="20dp"
            android:textSize="19sp" android:textColor="@color/text"
            android:text="Assistant / mic button opens Plain search, not Gemini" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="36dp" android:text="Hidden apps"
            android:textSize="22sp" android:textColor="@color/text" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Hold the select button on any app on the home screen to move or hide it. Select an app here to show it again."
            android:textSize="16sp" android:textColor="@color/muted" />
        <LinearLayout android:id="@+id/hiddenList"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="8dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="36dp" android:text="What the helper has seen recently"
            android:textSize="22sp" android:textColor="@color/text" />
        <TextView android:id="@+id/lastKey"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textSize="16sp" android:textColor="@color/muted" />
    </LinearLayout>
</ScrollView>
